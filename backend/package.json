{
  "name": "arqnova-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "prisma:seed": "npm run build && node dist/prisma/seed.js",
    "test:security": "npm run build && node --test test/security.test.cjs",
    "test:auth": "npm run build && node --test test/auth.test.cjs",
    "test:users": "npm run build && node --test test/users.test.cjs",
    "test:projects-base": "npm run build && node --test test/projects-base.test.cjs",
    "test:projects": "npm run build && node --test test/projects.test.cjs",
    "test:participants": "npm run build && node --test test/participants.test.cjs",
    "test:uml-base": "npm run build && node --test test/uml-base.test.cjs",
    "test:uml-editor": "npm run build && node --test test/uml-editor.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/websockets": "^12.0.3",
    "@prisma/client": "6.12.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "prisma": "6.12.0",
    "typescript": "~5.9.2"
  },
  "prisma": {
    "seed": "npm run prisma:seed"
  }
}
